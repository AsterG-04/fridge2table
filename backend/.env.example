# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Only needed in production. Leave unset for local dev to use the local
# SQLite file. In production (Render), set this to your Supabase project's
# Session Pooler connection string (Project Settings -> Database ->
# Connection Pooling in the Supabase dashboard), e.g.:
# postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=
